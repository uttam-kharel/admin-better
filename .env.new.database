# =============================================================================
#  .env.new.database — connect ANY Postgres database (Neon, Supabase, RDS, …)
# =============================================================================
#  Purpose: a clean, copy-paste template for wiring the app to a Postgres
#  database. Copy the parts you need into your real .env (local) or into the
#  Vercel project's Environment Variables (production — never commit secrets).
#
#  There are two equivalent ways to tell Laravel about the database:
#    (A) a single connection URL  → DATABASE_URL (preferred, used by Neon)
#    (B) individual variables     → DB_HOST / DB_PORT / DB_DATABASE / …
#  The app auto-switches from SQLite to Postgres the moment DATABASE_URL is
#  set (see config/database.php).
# =============================================================================

# ---------------------------------------------------------------------------
#  (A) Connection URL — one line, everything included
# ---------------------------------------------------------------------------
#  Neon dashboard → your project → Connect → "Pooled connection".
#  Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
#
#  ⚠️ POOLED vs UNPOOLED — this matters a lot:
#  DATABASE_URL          = PgBouncer POOLED connection. What the running app
#                          uses. Fast, shares connections between requests.
#  DATABASE_URL_UNPOOLED = DIRECT connection to one Postgres instance.
#                          REQUIRED for migrations/imports — the pooled proxy
#                          rejects schema changes ("current transaction is
#                          aborted"). Never run `php artisan migrate` against
#                          the pooled URL.
#
#  For Neon you get BOTH strings from the dashboard → Connect → "SQL editor"
#  vs "Pooled connection" tabs. Set both:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# ---------------------------------------------------------------------------
#  (B) Individual variables — same thing, split out (alternative to the URL)
# ---------------------------------------------------------------------------
# DB_CONNECTION=pgsql
# DB_HOST=ep-xxxx.ap-southeast-1.aws.neon.tech
# DB_PORT=5432
# DB_DATABASE=neondb
# DB_USERNAME=USER
# DB_PASSWORD=PASSWORD
# DB_SSLMODE=require

# When using individual vars, also tell the app to use Postgres explicitly:
DB_CONNECTION=sqlite            # local default — change to pgsql for Postgres
# DB_CONNECTION=pgsql

# ---------------------------------------------------------------------------
#  Cache — put it on the database too (serverless-safe, shared across
#  Vercel function instances). Requires the cache table (php artisan migrate).
# ---------------------------------------------------------------------------
CACHE_STORE=database

# Optional: Vercel KV / Upstash Redis for faster caching (needs TLS scheme):
# KV_URL=tls://default:TOKEN@HOST:6379

# ---------------------------------------------------------------------------
#  Commands you will actually run (use the UNPOOLED URL for all of these)
# ---------------------------------------------------------------------------
#  1. Create tables:
#     DB_CONNECTION=pgsql DATABASE_URL="$DATABASE_URL_UNPOOLED" php artisan migrate --force
#
#  2. Import the old SQLite data into Postgres:
#     DB_CONNECTION=pgsql DATABASE_URL="$DATABASE_URL_UNPOOLED" php artisan db:import-sqlite-to-pgsql
#
#  3. Test the connection:
#     DB_CONNECTION=pgsql DATABASE_URL="$DATABASE_URL_UNPOOLED" php artisan tinker
#     > DB::select('select 1');   // returns [{?column? => 1}] when it works

# ---------------------------------------------------------------------------
#  Production (Vercel) — set these in the project dashboard, NOT in this file:
#    Vercel → Project → Settings → Environment Variables:
#      DATABASE_URL          = pooled URL (runtime reads/writes)
#      DATABASE_URL_UNPOOLED = direct URL (used by CI migrations)
#      APP_KEY               = php artisan key:generate output (share the SAME
#                              key across local, CI and Vercel so encrypted
#                              sessions/cookies survive everywhere)
#      APP_ENV               = production
#      APP_DEBUG             = false
#      APP_URL               = https://sih-hospital.vercel.app
#      BLOB_READ_WRITE_TOKEN = vercel_blob_rw_… (images/PDFs uploads → CDN)
# ---------------------------------------------------------------------------
