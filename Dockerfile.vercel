# syntax=docker/dockerfile:1
# =============================================================================
#  Vercel container image for this Laravel app (deployed via Vercel Services).
#
#  Vercel builds this file (Dockerfile.vercel is declared in vercel.json),
#  stores the image in the Vercel Container Registry and runs it as a Function
#  that scales to zero. FrankenPHP (Caddy + PHP) serves /app/public.
# =============================================================================

# ---- Stage 1: PHP dependencies (Composer) ----------------------------------
FROM composer:2 AS composer
WORKDIR /app
COPY composer.json composer.lock ./
# --no-scripts: post-autoload-dump runs `artisan package:discover`, but the
# app code (and artisan) is not in this stage. package:discover is re-run in
# the runtime stage after the full app is copied in.
RUN composer install --no-dev --no-interaction --no-progress --prefer-dist --optimize-autoloader --no-scripts

# ---- Stage 2: Frontend assets (Vite) ---------------------------------------
FROM node:22-alpine AS frontend
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
# resources/js/app.js imports Livewire's JS straight from vendor/.
COPY --from=composer /app/vendor ./vendor
COPY . .
RUN npm run build

# ---- Stage 3: Runtime (FrankenPHP) -----------------------------------------
FROM dunglas/frankenphp:1-php8.4-alpine
WORKDIR /app

# Extensions the app needs that may not ship in the base image (no-ops when
# already present): Postgres for Neon, SQLite fallback, mbstring, intl, opcache.
RUN install-php-extensions pdo_pgsql pdo_sqlite mbstring intl opcache

# PHP INI overrides (upload caps aligned with Livewire + api/php.ini) and the
# Caddy site config + boot entrypoint.
COPY docker/php.ini /usr/local/etc/php/conf.d/zz-app.ini
COPY Caddyfile /etc/caddy/Caddyfile
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Application code + production dependencies.
COPY --from=composer /app/vendor ./vendor
COPY . .
COPY --from=frontend /app/public/build ./public/build

# Discover packages (post-autoload-dump was skipped in the composer stage),
# then compile Blade views + event manifest at build time.
# route:cache is intentionally skipped (routes/admin.php uses a closure) and
# config:cache runs at container boot so Vercel env vars are honored.
RUN php artisan package:discover --ansi && php artisan view:cache && php artisan event:cache

ENV PORT=80
EXPOSE 80

ENTRYPOINT ["entrypoint.sh"]
CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
