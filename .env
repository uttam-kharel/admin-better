# =============================================================================
#  Laravel environment template — Shubham International Hospital
# =============================================================================
#  Copy to .env locally:  cp .env.example .env
#
#  On Vercel, environment variables are set per-project in the dashboard
#  (Vercel → Project → Settings → Environment Variables) — NOT in this file.
#  This file documents every variable, what it does, and who sets it.
#
#  Vercel runtime defaults (see api/index.php) — these apply when the variable
#  is NOT set in the dashboard: SESSION_DRIVER=cookie, CACHE_STORE=array,
#  QUEUE_CONNECTION=sync, LOG_CHANNEL=stderr, file caches → /tmp.
# =============================================================================

# -----------------------------------------------------------------------------
#  Core application
# -----------------------------------------------------------------------------
APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:GaBf4/sqHGrQtOkmh1j+cln/QUCTx4YB4S0wD8i03JY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Application timezone. The site is in Nepal (UTC+5:45) — without this set
# to Asia/Kathmandu, visits made in the morning land on the PREVIOUS day in
# /admin/analytics ("today" shows 0 even though you visited). Set this on
# Vercel as well, or the code default (Asia/Kathmandu) applies automatically.
APP_TIMEZONE=Asia/Kathmandu

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Livewire stages file uploads (images, CVs) here before saving. On Vercel the
# filesystem is read-only except /tmp, so api/index.php sets this to the
# writable 'livewire-tmp' disk automatically. Override only if you mount a
# persistent disk (e.g. S3).
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=livewire-tmp

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
#  Database — Neon Postgres (persistent DB on Vercel)
# -----------------------------------------------------------------------------
#  Local default: the committed SQLite file (readable everywhere, but
#  READ-ONLY on Vercel — writes such as visits, admin CRUD and forms fail).
#
#  Production: connect a Neon Postgres database via Vercel → Storage →
#  Create Database → Neon Postgres → Connect Project. That integration
#  auto-adds DATABASE_URL and DATABASE_URL_UNPOOLED to the project env.
#
#  The app auto-switches to Postgres the moment DATABASE_URL is set
#  (see config/database.php) — no other change needed:
#
#     'default' => env('DB_CONNECTION', env('DATABASE_URL') ? 'pgsql' : 'sqlite'),
#
DB_CONNECTION=sqlite
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
#
#  ⚠️ POOLED vs UNPOOLED — important!
#  DATABASE_URL is the PgBouncer-pooled connection (what the app uses at
#  runtime). It FAILS on schema changes (DDL inside a transaction) with
#  "current transaction is aborted". Always run migrations / data imports
#  against the UNPOOLED connection string instead:
#
#  DATABASE_URL_UNPOOLED=postgresql://user:password@host:5432/dbname?sslmode=require
#
#  Commands:
#    DB_CONNECTION=pgsql DATABASE_URL="$DATABASE_URL_UNPOOLED" php artisan migrate --force
#    DB_CONNECTION=pgsql DATABASE_URL="$DATABASE_URL_UNPOOLED" php artisan db:import-sqlite-to-pgsql
#
#  You may also split the connection into individual vars instead of a URL:
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# -----------------------------------------------------------------------------
#  File storage — Vercel Blob (images, PDFs, CVs)
# -----------------------------------------------------------------------------
#  Every upload goes through app/Services/BlobStorage.php:
#   - token set     → uploaded to Vercel Blob, public CDN URL saved in the DB
#   - token missing → base64 data URI embedded in the DB (works, but no CDN)
#
#  Create it in Vercel → Storage → Create Database → Vercel Blob, then
#  connect it to the project — the token below is added to the project env
#  automatically. New uploads then return https://...public.blob.vercel-storage.com URLs.
#
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx

# -----------------------------------------------------------------------------
#  Sessions
# -----------------------------------------------------------------------------
#  On Vercel, SESSION_DRIVER defaults to cookie (set in api/index.php) unless
#  overridden here. Cookie sessions work without any table; switch to
#  'database' only after Postgres is connected if you want server-side sessions.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# -----------------------------------------------------------------------------
#  Cache — Vercel KV / Upstash Redis (optional)
# -----------------------------------------------------------------------------
#  With KV_URL (or REDIS_URL) set, CACHE_STORE auto-switches to redis and the
#  client becomes predis (pure PHP — no phpredis extension on vercel-php).
#  On Vercel, CACHE_STORE defaults to 'array' (per-request) when unset.
#  Create KV in Vercel → Storage → Create Database → Vercel KV; the URL needs
#  TLS, so change the scheme from redis:// to tls:// when pasting.
CACHE_STORE=database
# KV_URL=tls://default:token@host:6379
# CACHE_PREFIX=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_URL=

# -----------------------------------------------------------------------------
#  Mail
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
#  AWS (unused — kept for Laravel defaults)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
#  CI/CD — GitHub Actions → Vercel deploy
# =============================================================================
#  The workflow (.github/workflows/deploy-vercel.yml) deploys to Vercel on
#  every push to main. These are REPOSITORY SECRETS (GitHub → Settings →
#  Secrets and variables → Actions), NOT app env vars — the app itself never
#  reads them, only the CI pipeline does:
#
#  VERCEL_TOKEN        – Vercel API token: vercel.com/account/tokens
#                        (must belong to the Vercel account/project you deploy to)
#  VERCEL_ORG_ID       – team_...  (Vercel → your team → Settings → General)
#  VERCEL_PROJECT_ID   – prj_...   (Vercel → your project → Settings → General)
#  DATABASE_URL        – Neon connection string (pooled). If set, CI runs
#                        `php artisan migrate --force` before deploying
#                        (against a copy of .env.example — see note below).
#
#  What CI does on push to main:
#    1. checkout + composer install + npm ci
#    2. npm run build (frontend assets → public/build)
#    3. IF the DATABASE_URL secret exists: cp .env.example .env
#       && php artisan migrate --force  (schema applied to Neon)
#    4. npx vercel --prod --token=$VERCEL_TOKEN  (deploys to the project
#       identified by VERCEL_ORG_ID + VERCEL_PROJECT_ID)
#
#  ⚠️ The migrate step copies .env.example, so keep this file accurate for
#  production. If any migration uses encrypted columns, also add an APP_KEY
#  repository secret (the example below is intentionally empty locally).
#
#  How the two deployments relate:
#   - `sih-hospital.vercel.app` (your account): deployed from this machine
#     with `npx vercel --prod`. Not tied to GitHub — push alone won't update it
#     unless you add the matching secrets to this repo and link it.
#   - `v1.sih.com.np` (client's account): deployed by the GitHub workflow
#     using that account's secrets (this repo's CI is already wired to it).
# =============================================================================
# VERCEL_TOKEN=
# VERCEL_ORG_ID=team_xxxxxxxxxxxxxxxxxxxxx
# VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxx
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
